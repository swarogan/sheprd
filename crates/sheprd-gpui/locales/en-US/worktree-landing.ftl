# The new worktree dialog's choice of what the checkout's first pane shows:
# its shell, an agent started in it, or a chat with an agent. Agent names
# are program names and stay untranslated.
worktree-landing-label = Opens in
# Labels the row of tiles that open in a terminal: the shell, then agents.
worktree-landing-terminal = Terminal
# Labels the row of tiles that open an agent as a chat.
worktree-landing-chat = Chat
# Names the tile that opens the checkout's shell alone.
worktree-landing-shell = Shell
# Names a chat tile. $agent is the agent's name, such as Claude.
worktree-landing-chat-agent = { $agent } chat
worktree-landing-looking = Looking for agents…
# $agent is the agent's name, such as claude; $error says why.
worktree-landing-failed = Could not start { $agent } in the new worktree: { $error }
