/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

/assets/*
  Cache-Control: public, max-age=3600

# Install scripts and llms.txt are read by shells, PowerShell and agents as text.
/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/install.ps1
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/llms.txt
  Content-Type: text/plain; charset=utf-8

# Sheprd's relays, read by Sheprd and the phone apps (docs/relay-plan.md).
# Short-lived, so adding or removing a relay reaches clients within minutes.
/relays.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300

# The relay deploy page sends a DigitalOcean token to api.digitalocean.com
# only, and reads the relay's files from GitHub; nothing else may load or run.
/relay/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src https://api.digitalocean.com https://raw.githubusercontent.com https://*.sslip.io; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
